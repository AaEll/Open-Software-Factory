# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Fireworks (OpenAI-compatible) — required for live LLM site generation.
# Get a key at https://fireworks.ai (format: fw_...)
FIREWORKS_API_KEY=

# Model selection in opencode provider/model form. Optional; defaults to
# fireworks/accounts/fireworks/models/kimi-k2p7-code.
# OSF_MODEL=fireworks/accounts/fireworks/models/kimi-k2p7-code

# Only needed if you select an anthropic/* model instead.
# ANTHROPIC_API_KEY=

# PromptPay broker (OSF → preview/domain/payment). Start PromptPay on this URL first.
# PROMPTPAY_URL=http://127.0.0.1:8090

# MVP PromptPay eval (python -m evals.mvp_promptpay) — optional overrides:
# OSF_PROMPT=A landing page for a coffee shop called Mountain Brew
# OSF_DOMAIN=42protein.com
# OSF_OBJECTIVE_ID=mvp-demo
