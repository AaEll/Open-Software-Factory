# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Fireworks (OpenAI-compatible) — the factory's default engine.
FIREWORKS_API_KEY=

# Model selection in opencode provider/model form. Optional; defaults to
# fireworks/accounts/fireworks/models/kimi-k2-instruct.
# OSF_MODEL=fireworks/accounts/fireworks/models/kimi-k2-instruct

# Only needed if you select an anthropic/* model instead.
# ANTHROPIC_API_KEY=
